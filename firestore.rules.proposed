rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isYohana() { return signedIn() && request.auth.uid == 'F2SHGFQYSuMWlkbQKV8yrKAXgaH3'; }
    function isBibiana() { return signedIn() && request.auth.uid == 'MtQpryHLGYab5v3UjhRZw88CAD63'; }
    function isAngela() { return signedIn() && request.auth.uid == 'IEB65uKdgldevmgRuenCj7pPwc12'; }
    function isGina() { return signedIn() && request.auth.uid == 'yI067cx29zbmiBOd9wyKcwp0HpF2'; }
    function isStaff() { return isYohana() || isBibiana() || isAngela() || isGina(); }

    // El catálogo se puede consultar públicamente. Solo quienes administran
    // inventario pueden editarlo desde Gestión; las ventas del Worker usan
    // Firebase Admin y no dependen de estas reglas.
    match /productos/{id} {
      allow read: if true;
      allow create, update, delete: if isYohana() || isBibiana();
    }

    match /pedidos/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isYohana();
    }

    match /movimientos_inventario/{id} {
      allow read: if isYohana();
      allow write: if false;
    }

    match /solicitudes_pedido/{id} {
      allow read, write: if false;
    }

    match /auditoria/{id} {
      allow read: if isYohana();
      allow write: if false;
    }

    // Mantener las colecciones operativas existentes con acceso del equipo.
    match /{document=**} {
      allow read, write: if isStaff();
    }
  }
}
